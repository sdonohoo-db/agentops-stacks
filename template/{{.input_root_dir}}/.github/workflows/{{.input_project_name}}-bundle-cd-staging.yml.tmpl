# Staging deploy for {{ .input_project_name }} — validates, deploys, runs post-deploy eval gate if applied.
name: Staging deploy for {{ .input_project_name }}

on:
  push:
    branches:
      - 'main'
  workflow_dispatch:

defaults:
  run:
    working-directory: .

env:
  {{ if (eq .input_cloud `azure`) -}}
  ARM_TENANT_ID: {{`${{ secrets.STAGING_AZURE_SP_TENANT_ID }}`}}
  ARM_CLIENT_ID: {{`${{ secrets.STAGING_AZURE_SP_APPLICATION_ID }}`}}
  ARM_CLIENT_SECRET: {{`${{ secrets.STAGING_AZURE_SP_CLIENT_SECRET }}`}}
  {{- else -}}
  DATABRICKS_TOKEN: {{`${{ secrets.STAGING_WORKSPACE_TOKEN }}`}}
  {{- end }}

jobs:
  deploy:
    concurrency: {{ .input_project_name }}-staging-bundle-job
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: databricks/setup-cli@{{template `cli_version` .}}
      - name: Validate bundle for staging
        run: databricks bundle validate -t staging
      - name: Deploy bundle to staging
        run: databricks bundle deploy -t staging

  eval_gate:
    needs: deploy
    if: ${{ hashFiles('evaluation/thresholds.yml') != '' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true
      - run: uv sync
      - name: Run eval gate (post-deploy)
        run: |
          if [ -f evaluation/gate.py ]; then
            uv run python evaluation/gate.py
          else
            echo "::error::evaluation/thresholds.yml exists but evaluation/gate.py is missing."
            exit 1
          fi
