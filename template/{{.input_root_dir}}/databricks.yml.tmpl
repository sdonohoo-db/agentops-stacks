bundle:
  name: {{ .input_project_name }}
  engine: direct

variables:
  catalog:
    description: Unity Catalog for project resources (overridden per target)
  schema:
    description: Schema within the catalog for resources, traces, and artifacts
    default: {{ .input_project_name }}

include:
  - ./resources/*.yml

sync:
  include:
    - pyproject.toml

targets:
  dev:
    default: true
    mode: development
    workspace:
      host: # TODO: set dev workspace URL
    variables:
      catalog: {{ .input_project_name }}_dev

  staging:
    mode: production
    workspace:
      host: # TODO: set staging workspace URL
      # Recommended for production targets: set an explicit root_path so deploys
      # are deterministic regardless of who or what deploys (CI SP vs. local user).
      # Typically uses the deploying identity's home path. For SP-driven CI/CD:
      #   root_path: /Workspace/Users/<sp-application-id>/.bundle/${bundle.name}/${bundle.target}
      # For user-deployed targets:
      #   root_path: /Workspace/Users/<user-email>/.bundle/${bundle.name}/${bundle.target}
    variables:
      catalog: {{ .input_project_name }}_staging
    # Production mode requires run_as. Default to the deploying user; switch to a
    # service principal before going to real production:
    #   run_as:
    #     service_principal_name: <sp-application-id>
    run_as:
      user_name: ${workspace.current_user.userName}

  prod:
    mode: production
    workspace:
      host: # TODO: set prod workspace URL
      # Recommended for production targets: set an explicit root_path so deploys
      # are deterministic regardless of who or what deploys (CI SP vs. local user).
      # Typically uses the deploying identity's home path. For SP-driven CI/CD:
      #   root_path: /Workspace/Users/<sp-application-id>/.bundle/${bundle.name}/${bundle.target}
      # For user-deployed targets:
      #   root_path: /Workspace/Users/<user-email>/.bundle/${bundle.name}/${bundle.target}
    variables:
      catalog: {{ .input_project_name }}_prod
    # Production mode requires run_as. Default to the deploying user; switch to a
    # service principal before going to real production:
    #   run_as:
    #     service_principal_name: <sp-application-id>
    run_as:
      user_name: ${workspace.current_user.userName}
