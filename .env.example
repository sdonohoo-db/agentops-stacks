# AgentOps Redux — Environment Variables
# ========================================
# Copy this file to .env and fill in your values, OR export each variable
# in your shell profile. Never commit .env to source control.
#
# Variables marked [REQUIRED] must be set before any framework operation.
# Variables marked [OPTIONAL] have sensible defaults — only set to override.
# Variables marked [CI/CD] are only needed for GitHub Actions secrets.
# Variables marked [MCP] are only needed when running the MCP server.
#
# Quick start: set the four REQUIRED vars and you're ready to run unit tests
# and deploy to dev. Everything else is optional for initial setup.

# ── Databricks Connection ─────────────────────────────────────────────────────

# [REQUIRED] Your Databricks workspace URL. Include https://, no trailing slash.
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net

# [REQUIRED] Personal access token or service principal token.
# Generate at: Settings > Developer > Access Tokens in the Databricks UI.
DATABRICKS_TOKEN=dapi...

# ── AgentOps Environment ──────────────────────────────────────────────────────

# [REQUIRED] Which environment you are working in.
# Determines which catalog/schema the framework reads and writes.
# Values: dev | staging | prod
AGENTOPS_ENV=dev

# [REQUIRED by AgentOpsConfig] Same workspace URL as DATABRICKS_HOST above.
# Used by the Python framework code (AgentOpsConfig) rather than the CLI.
AGENTOPS_WORKSPACE_HOST=https://your-workspace.azuredatabricks.net

# ── Unity Catalog ─────────────────────────────────────────────────────────────

# [OPTIONAL] Name of the Unity Catalog catalog for dev/staging assets.
# Default: agentops_dev
AGENTOPS_DEV_CATALOG=agentops_dev

# [OPTIONAL] Name of the Unity Catalog catalog for production assets.
# Default: agentops_prod
AGENTOPS_PROD_CATALOG=agentops_prod

# [OPTIONAL] Schema within the dev catalog.
# Default: agentops
AGENTOPS_DEV_SCHEMA=agentops

# [OPTIONAL] Schema within the prod catalog.
# Default: agentops
AGENTOPS_PROD_SCHEMA=agentops

# ── Databricks Services ───────────────────────────────────────────────────────

# [OPTIONAL] Name of the Vector Search endpoint.
# Created by scripts/setup.py if it doesn't exist.
# Default: agentops_vs_endpoint
AGENTOPS_VECTOR_SEARCH_ENDPOINT=agentops_vs_endpoint

# [OPTIONAL] Name of the Model Serving endpoint.
# Created by the App Deployment Workflow.
# Default: agentops_endpoint
AGENTOPS_MODEL_SERVING_ENDPOINT=agentops_endpoint

# [OPTIONAL] Base path for MLflow experiments.
# Experiments are created as {base}/{env}, e.g. /AgentOps/dev
# Default: /AgentOps
AGENTOPS_MLFLOW_EXPERIMENT_BASE=/AgentOps

# ── LLM and Embedding Models ──────────────────────────────────────────────────

# [OPTIONAL] Databricks Foundation Model API endpoint for LLM calls.
# Default: databricks-meta-llama-3-3-70b-instruct
# Other options: databricks-meta-llama-3-1-405b-instruct, databricks-claude-3-7-sonnet
AGENTOPS_LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# [OPTIONAL] Databricks embedding model endpoint.
# Must match the embedding model used when the Vector Search index was created.
# Default: databricks-bge-large-en
AGENTOPS_EMBEDDING_ENDPOINT=databricks-bge-large-en

# ── MCP Server ────────────────────────────────────────────────────────────────

# [MCP] Absolute path to the project root. Used by the MCP server to locate
# project files. Set this when running agentops_mcp/server.py directly.
# Example: /Users/yourname/projects/agentops-redux
AGENTOPS_PROJECT_ROOT=/path/to/agentops-redux

# ── GitHub Actions (CI/CD secrets) ───────────────────────────────────────────
# These are not used locally. Add them as repository secrets in:
# GitHub > Settings > Secrets and variables > Actions
#
# DATABRICKS_STAGING_HOST=https://your-staging-workspace.azuredatabricks.net
# DATABRICKS_STAGING_TOKEN=dapi...
# DATABRICKS_PROD_HOST=https://your-prod-workspace.azuredatabricks.net
# DATABRICKS_PROD_TOKEN=dapi...
