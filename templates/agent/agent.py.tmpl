from __future__ import annotations

import logging
from typing import Any, Dict, List, Optional

import mlflow
from langchain_databricks import ChatDatabricks

from framework.agent_development.agent_base import AgentBase
from framework.config import AgentOpsConfig, get_config

logger = logging.getLogger(__name__)


class {class_name}(AgentBase):
    """
    {description}

    Example:
        >>> agent = {class_name}()
        >>> result = agent.predict(None, {{
        ...     "messages": [{{"role": "user", "content": "Hello"}}]
        ... }})
        >>> print(result["content"])
    """

    def __init__(
        self,
        llm_endpoint: Optional[str] = None,
        config: Optional[AgentOpsConfig] = None,
    ) -> None:
        super().__init__(
            name="{agent_name}",
            description="{description}",
            config=config,
        )
        self._llm_endpoint = llm_endpoint or self.config.llm_endpoint
        self._llm = None

    @property
    def llm(self) -> ChatDatabricks:
        if self._llm is None:
            self._llm = ChatDatabricks(
                endpoint=self._llm_endpoint,
                temperature=0.1,
                max_tokens=1024,
            )
        return self._llm

    @mlflow.trace(name="{agent_name}.invoke", span_type="AGENT")
    def _invoke(
        self,
        messages: List[Dict[str, str]],
        context: Optional[Any] = None,
    ) -> str:
        """
        TODO: Implement your agent logic here.

        Args:
            messages: List of {{"role": ..., "content": ...}} dicts.
            context:  MLflow model context (for artifact access).

        Returns:
            Response string.
        """
        user_messages = [m for m in messages if m.get("role") == "user"]
        if not user_messages:
            return "Please provide a message."

        # TODO: Replace with your agent logic
        from langchain_core.messages import HumanMessage
        response = self.llm.invoke([HumanMessage(content=user_messages[-1]["content"])])
        return response.content
