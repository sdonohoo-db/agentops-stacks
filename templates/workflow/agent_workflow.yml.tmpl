# {agent_name_title} Workflow
# Auto-generated by scripts/scaffold.py

resources:
  jobs:
    {agent_name}_workflow:
      name: "[AgentOps] {agent_name_title}"
      description: "{description}"

      tags:
        agentops_component: {agent_name}
        agentops_env: ${bundle.target}

      job_clusters:
        - job_cluster_key: {agent_name}_cluster
          new_cluster:
            spark_version: 15.4.x-scala2.12
            node_type_id: m5d.xlarge
            num_workers: 1

      tasks:
        - task_key: {agent_name}_tools
          description: Register {agent_name_title} tools in Unity Catalog
          job_cluster_key: {agent_name}_cluster
          python_wheel_task:
            package_name: agentops_framework
            entry_point: run_{agent_name}_tools
          libraries:
            - whl: ./dist/agentops_framework-*.whl
          timeout_seconds: 600

        - task_key: {agent_name}_dev
          description: Develop and configure {agent_name_title}
          depends_on:
            - task_key: {agent_name}_tools
          job_cluster_key: {agent_name}_cluster
          python_wheel_task:
            package_name: agentops_framework
            entry_point: run_{agent_name}_dev
          libraries:
            - whl: ./dist/agentops_framework-*.whl
          timeout_seconds: 1800

        - task_key: {agent_name}_eval
          description: Evaluate {agent_name_title} quality
          depends_on:
            - task_key: {agent_name}_dev
          job_cluster_key: {agent_name}_cluster
          python_wheel_task:
            package_name: agentops_framework
            entry_point: run_{agent_name}_eval
          libraries:
            - whl: ./dist/agentops_framework-*.whl
          timeout_seconds: 3600
